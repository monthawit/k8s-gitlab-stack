# Template for the "gitlab-rails-storage" secret (object storage connection
# for artifacts/LFS/uploads/packages/etc — see global.appConfig.object_store
# in gitlab/gitlab-values.yaml).
#
# Copy this file to rails.yaml (gitignored — never commit the real one),
# fill in real credentials, then:
#
#   kubectl create secret generic gitlab-rails-storage \
#     -n gitlab \
#     --from-file=connection=rails.yaml
#
# Buckets referenced by gitlab-values.yaml must already exist on the
# object store before install:
#   gitlab-artifacts
#   gitlab-lfs
#   gitlab-uploads
#   gitlab-packages
#   gitlab-mr-diffs
#   gitlab-terraform-state
#   gitlab-ci-secure-files
#   gitlab-dependency-proxy
#   gitlab-agent-plan-content
#   gitlab-ci-catalog-bundles
#   gitlab-registry
#   gitlab-backups
#   gitlab-backups-tmp

provider: AWS
region: <RGW_REGION>
aws_access_key_id: <ACCESS_KEY>
aws_secret_access_key: <SECRET_KEY>
endpoint: http://<RGW_SERVICE_HOST>
path_style: true
root@milkyk8s-master-01:/home/ubuntu/gitlab-chatgpt/gitlab-stack/secrets# ls
README.md  rails.yaml.example  storage.config.example
root@milkyk8s-master-01:/home/ubuntu/gitlab-chatgpt/gitlab-stack/secrets# cat storage.config.example
# Template for the "gitlab-backup-storage" secret (s3cmd-format config used
# by gitlab-toolbox for `backup-utility` upload/download — see
# gitlab.toolbox.backups.objectStorage.config in gitlab/gitlab-values.yaml).
#
# Copy this file to storage.config (gitignored — never commit the real one),
# fill in real credentials, then:
#
#   kubectl create secret generic gitlab-backup-storage \
#     -n gitlab \
#     --from-file=config=storage.config
#
# IMPORTANT: use_https and host_bucket here must describe the SAME endpoint
# the same way rails.yaml.example does (scheme + path-style vs
# virtual-hosted-style addressing). These two files historically drifted
# out of sync in this project (one used http+path-style, the other
# https+virtual-hosted-style) for the same backend, which breaks whichever
# one is wrong. Confirm your RGW endpoint's actual TLS/DNS setup before
# filling this in.

[default]
access_key = <ACCESS_KEY>
secret_key = <SECRET_KEY>
bucket_location = <RGW_REGION>
host_base = <RGW_SERVICE_HOST>
host_bucket = %(bucket)s.<RGW_SERVICE_HOST>
use_https = True
